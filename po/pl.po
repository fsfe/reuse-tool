#: src/reuse/_annotate.py:96
#, python-brace-format
msgid "Skipped unrecognised file '{path}'"
msgstr "Pominięto nierozpoznany plik „{path}”"

#: src/reuse/_annotate.py:102
#, python-brace-format
msgid "'{path}' is not recognised; creating '{path}.license'"
msgstr "Nierozpoznano „{path}”; tworzenie „{path}.license”"

#: src/reuse/_annotate.py:118
#, python-brace-format
msgid "Skipped file '{path}' already containing REUSE information"
msgstr "Pominięto plik „{path}” już posiadający informację REUSE"

#: src/reuse/_annotate.py:148
#, python-brace-format
msgid "Error: Could not create comment for '{path}'"
msgstr "Błąd: Nie można było utworzyć komentarza dla „{path}”"

#: src/reuse/_annotate.py:155
#, python-brace-format
msgid ""
"Error: Generated comment header for '{path}' is missing copyright lines or "
"license expressions. The template is probably incorrect. Did not write new "
"header."
msgstr ""
"Błąd: W wygenerowanym nagłówku komentarza „{path}” brakuje linii praw "
"autorskich lub wyjątków licencyjnych. Szablon jest prawdopodobnie "
"niepoprawny. Nie zapisano nowego nagłówka."

#. TODO: This may need to be rephrased more elegantly.
#: src/reuse/_annotate.py:166
#, python-brace-format
msgid "Successfully changed header of {path}"
msgstr "Poprawnie zmieniono nagłówkek w {path}"

#: src/reuse/cli/annotate.py:95
msgid "Option '--copyright', '--license', or '--contributor' is required."
msgstr "Wymagana opcja „--copyright”, „--license” lub „--contributor”."

#: src/reuse/cli/annotate.py:156
msgid ""
"The following files do not have a recognised file extension. Please use '--"
"style', '--force-dot-license', '--fallback-dot-license', or '--skip-"
"unrecognised':"
msgstr ""
"Dane pliki nie posiadają rozpoznawalnego rozszerzenia plików. Proszę użyć „--"
"style”, „--force-dot-license”, „--fallback-dot-license” lub „--skip-"
"unrecognised”:"

#: src/reuse/cli/annotate.py:189
#, python-brace-format
msgid ""
"'{path}' does not support single-line comments, please do not use '--single-"
"line'."
msgstr ""
"„{path}” nie obsługuje komentarzy jednoliniowych, proszę nie używać „--"
"single-line”."

#: src/reuse/cli/annotate.py:196
#, python-brace-format
msgid ""
"'{path}' does not support multi-line comments, please do not use '--multi-"
"line'."
msgstr ""
"„{path}” nie obsługuje komentarzy wieloliniowych, proszę nie używać „--multi-"
"line”."

#: src/reuse/cli/annotate.py:242
#, python-brace-format
msgid "Template '{template}' could not be found."
msgstr "Szablon „{template}” nie został znaleziony."

#: src/reuse/cli/annotate.py:265
#, python-brace-format
msgid "'{year}' is not a valid year range."
msgstr "„{year}” nie jest prawidłowym zakresem lat."

#: src/reuse/cli/annotate.py:274
#, python-brace-format
msgid ""
"Your operating system's year is set to '{year}'. This is not four digits, "
"and not supported."
msgstr ""
"Rok twojego systemu operacyjnego jest ustawiony na „{year}”. Nie jest "
"czterocyfrowy, przez co nie jest obsługiwany."

#: src/reuse/cli/annotate.py:318
msgid "Add copyright and licensing into the headers of files."
msgstr "Dodaj adnotacje praw autorskich i licencji do nagłówków plików."

#: src/reuse/cli/annotate.py:321
msgid ""
"By using --copyright and --license, you can specify which copyright holders "
"and licenses to add to the headers of the given files."
msgstr ""
"Przez użycie --copyright i --license, możesz zdefiniować którzy posiadacze "
"praw autorskich oraz które licencje dodać do nagłówków w danych plikach."

#: src/reuse/cli/annotate.py:327
msgid ""
"By using --contributor, you can specify people or entity that contributed "
"but are not copyright holder of the given files."
msgstr ""
"Używając --contributor, możesz określać ludzi lub podmiot, którzy wnieśli "
"wkład, lecz nie są posiadaczami praw autorskich."

#. TRANSLATORS: You may translate this. Please preserve capital letters.
#: src/reuse/cli/annotate.py:340
msgid "COPYRIGHT"
msgstr "PRAWA AUTORSKIE"

#: src/reuse/cli/annotate.py:343
msgid "Copyright holder, repeatable."
msgstr "Posiadacz praw autorskich, powtarzalne."

#. TRANSLATORS: You may translate this. Please preserve capital letters.
#: src/reuse/cli/annotate.py:350
msgid "SPDX_IDENTIFIER"
msgstr "IDENTYFIKATOR_SPDX"

#: src/reuse/cli/annotate.py:353
msgid "SPDX License Identifier, repeatable."
msgstr "Identyfikator licencji SPDX, powtarzalne."

#. TRANSLATORS: You may translate this. Please preserve capital letters.
#: src/reuse/cli/annotate.py:359
msgid "CONTRIBUTOR"
msgstr "WSPÓŁTWÓRCA"

#: src/reuse/cli/annotate.py:362
msgid "File contributor, repeatable."
msgstr "Współtworca pliku, powtarzalne."

#. TRANSLATORS: You may translate this. Please preserve capital letters.
#: src/reuse/cli/annotate.py:369
msgid "YEAR"
msgstr "ROK"

#: src/reuse/cli/annotate.py:374
msgid ""
"Year of copyright notice. You may define multiple years or a range of years."
msgstr ""
"Rok adnotacji praw autorskich. Można zdefiniować wiele lat lub zakres lat."

#: src/reuse/cli/annotate.py:384
msgid "Comment style to use."
msgstr "Styl komentarzy do użycia."

#: src/reuse/cli/annotate.py:394
msgid "Copyright prefix to use."
msgstr "Prefiks adnotacji praw autorskich do użycia."

#. TRANSLATORS: You may translate this. Please preserve capital letters.
#: src/reuse/cli/annotate.py:406
msgid "TEMPLATE"
msgstr "SZABLON"

#: src/reuse/cli/annotate.py:408
msgid "Name of template to use."
msgstr "Nazwa szablonu do użycia."

#: src/reuse/cli/annotate.py:415
msgid "Do not include year in copyright notice."
msgstr "Nie uwzględniaj roku w adnotacji praw autorskich."

#: src/reuse/cli/annotate.py:421
msgid "Merge copyright notices if they are identical except for their years."
msgstr "Uwspólnij adnotacje praw autorskich jeśli są identyczne prócz ich lat."

#: src/reuse/cli/annotate.py:429
msgid "Force single-line comment style."
msgstr "Wymuszaj styl komentarzy jednoliniowych."

#: src/reuse/cli/annotate.py:436
msgid "Force multi-line comment style."
msgstr "Wymuszaj styl komentarzy wieloliniowych."

#: src/reuse/cli/annotate.py:442
msgid "Add headers to all files under specified directories recursively."
msgstr ""
"Rekursywnie dodaj nagłówki do wszystkich plików w zdefiniowanym katalogu."

#: src/reuse/cli/annotate.py:449
msgid "Do not replace the first header in the file; just add a new one."
msgstr "Nie zastępuj pierwszego nagłówka w pliku; po prostu dodaj nowy."

#: src/reuse/cli/annotate.py:457
msgid "Replace existing SPDX-License-Identifiers, instead of adding onto them."
msgstr "Zastąp istniejące SPDX-License-Identifiers, zamiast do nich dodawania."

#: src/reuse/cli/annotate.py:466
msgid "Always write a .license file instead of a header inside the file."
msgstr "Zawsze zapisuj jako plik .license zamiast nagłówka w pliku."

#: src/reuse/cli/annotate.py:473
msgid "Write a .license file to files with unrecognised comment styles."
msgstr ""
"Zapisuj jako plik .license dla plików z nierozpoznawalnym stylem komentarzy."

#: src/reuse/cli/annotate.py:480
msgid "Skip files with unrecognised comment styles."
msgstr "Pomiń pliki z nierozpoznawalnym stylem komentarzy."

#: src/reuse/cli/annotate.py:491
msgid "Skip files that already contain REUSE information."
msgstr "Pomiń pliki które już posiadają informację REUSE."

#: src/reuse/cli/annotate.py:498
msgid "Skip files that are covered by REUSE.toml or .reuse/dep5."
msgstr "Pomiń pliki które już są pokryte przez REUSE.toml lub .reuse/dep5."

#: src/reuse/cli/annotate.py:507
msgid ""
"Skip files that are covered by REUSE.toml or .reuse/dep5 with a specific "
"precedence level, repeatable."
msgstr ""
"Pomiń pliki które już są pokryte przez REUSE.toml lub .reuse/dep5 z "
"określonym stopniem pierwszeństwa, powtarzalne."

#. TRANSLATORS: You may translate this. Please preserve capital letters.
#: src/reuse/cli/annotate.py:514
msgid "PATH"
msgstr "ŚCIEŻKA"

#: src/reuse/cli/annotate.py:580
#, python-brace-format
msgid "Skipped file '{path}' which is already covered by '{source}'"
msgstr "Pominięto plik „{path}”, który jest już pokryty przez „{source}”"

#: src/reuse/cli/annotate.py:593
#, python-brace-format
msgid "'{path}' is a binary, therefore using '{new_path}' for the header"
msgstr "„{path}” jest plikiem binarnym, stąd użycie „{new_path}” dla nagłówka"

#: src/reuse/cli/common.py:51
#, python-brace-format
msgid ""
"'{path}' could not be parsed. We received the following error message: "
"{message}"
msgstr ""
"„{path}” nie mógł być przetworzony. Otrzymaliśmy następujący komunikat "
"błędu: {message}"

#: src/reuse/cli/common.py:87
#, python-brace-format
msgid "'{name}' is mutually exclusive with: {opts}"
msgstr "„{name}” jest w sprzeczności z: {opts}"

#: src/reuse/cli/common.py:103
msgid "'{}' is not a valid SPDX expression."
msgstr "„{}” nie jest poprawnym wyrażeniem SPDX."

#: src/reuse/cli/convert_dep5.py:19
msgid ""
"Convert .reuse/dep5 into a REUSE.toml file. The generated file is placed in "
"the project root and is semantically identical. The .reuse/dep5 file is "
"subsequently deleted."
msgstr ""
"Konwertuj .reuse/dep5 na plik REUSE.toml. Wygenerowany plik jest umieszczany "
"w ścieżce głównej projektu i semantycznie identyczny. Następnie .reuse/dep5 "
"zostanie usunięty."

#: src/reuse/cli/convert_dep5.py:31
msgid "No '.reuse/dep5' file."
msgstr "Brak pliku „.reuse/dep5”."

#: src/reuse/cli/download.py:51
msgid "'{}' is not a valid SPDX License Identifier."
msgstr "„{}” nie jest prawidłowym identyfikatorem licencji SPDX."

#: src/reuse/cli/download.py:58
msgid "Did you mean:"
msgstr "Czy chodziło ci o:"

#: src/reuse/cli/download.py:65
msgid ""
"See <https://spdx.org/licenses/> for a list of valid SPDX License "
"Identifiers."
msgstr ""
"Sprawdź <https://spdx.org/licenses/> dla listy poprawnych identyfikatorów "
"licencji SPDX."

#: src/reuse/cli/download.py:74
#, python-brace-format
msgid "Error: {spdx_identifier} already exists."
msgstr "Błąd: {spdx_identifier} już istnieje."

#: src/reuse/cli/download.py:81
#, python-brace-format
msgid "Error: {path} does not exist."
msgstr "Błąd: {path} nie istnieje."

#: src/reuse/cli/download.py:85
msgid "Error: Failed to download license."
msgstr "Błąd: Nie udało się pobrać licencji."

#: src/reuse/cli/download.py:90
msgid "Is your internet connection working?"
msgstr "Czy działa twoje połączenie internetowe?"

#: src/reuse/cli/download.py:95
#, python-brace-format
msgid "Successfully downloaded {spdx_identifier}."
msgstr "Poprawnie pobrano {spdx_identifier}."

#: src/reuse/cli/download.py:105
msgid "Download a license and place it in the LICENSES/ directory."
msgstr "Pobierz licencję i umieść ją w katalogu LICENSES/."

#: src/reuse/cli/download.py:109
msgid ""
"LICENSE should be a valid SPDX License Identifier. You may specify LICENSE "
"multiple times to download multiple licenses."
msgstr ""
"LICENCJA musi być poprawnym identyfikatorem SPDX. Możesz określić LICENCJĘ "
"wielokrotnie celem ściągnięcia wielu licencji."

#: src/reuse/cli/download.py:115
msgid ""
"If LICENSE starts with LicenseRef-, then a corresponding empty file is "
"created in the LICENSES/ directory."
msgstr ""
"Jeżeli LICENCJA rozpoczyna się od LicenseRef-, to odpowiedni pusty plik jest "
"tworzony w katalogu LICENSES/."

#: src/reuse/cli/download.py:128
msgid "Download all missing licenses detected in the project."
msgstr "Ściągnij wszystkie brakujące licencje w projekcie."

#: src/reuse/cli/download.py:136
msgid "Path to download to."
msgstr "Ścieżka, do której pobierać."

#: src/reuse/cli/download.py:142
msgid ""
"Source from which to copy license files; either a directory that contains "
"the file or the file itself."
msgstr ""
"Źródło, z którego kopiować pliki licencji; albo katalog zawierający plik, "
"albo sam plik."

#. TRANSLATORS: You may translate this. Please preserve capital letters.
#: src/reuse/cli/download.py:149
msgid "LICENSE"
msgstr "LICENCJA"

#: src/reuse/cli/download.py:165
msgid "The 'LICENSE' argument and '--all' option are mutually exclusive."
msgstr "Argument z „LICENCJĄ” lub „--all” są ze sobą sprzeczne."

#: src/reuse/cli/download.py:177
msgid "Cannot use '--output' with more than one license."
msgstr "Nie można użyć „--output” z więcej niż jedną licencją."

#: src/reuse/cli/lint.py:28
#, python-brace-format
msgid ""
"Lint the project directory for REUSE compliance. This version of the tool "
"checks against version {reuse_version} of the REUSE Specification. You can "
"find the latest version of the specification at <https://reuse.software/spec/"
">."
msgstr ""
"Sprawdzaj katalog projektu z zgodnością z REUSE. Ta wersja narzędzia "
"sprawdza zgodność z wersją {reuse_version} specyfikacji REUSE. Możesz "
"znaleźć najnowszą wersję specyfikacji na <https://reuse.software/spec/>."

#: src/reuse/cli/lint.py:34
msgid "Specifically, the following criteria are checked:"
msgstr "Dokładnie, poniższe kryteria są sprawdzane:"

#: src/reuse/cli/lint.py:38
msgid ""
"- Are there any bad (unrecognised, not compliant with SPDX) licenses in the "
"project?"
msgstr ""
"- Czy są jakieś niepoprawne (nierozpoznane, nie zgodne z SPDX) licencje w "
"projekcie?"

#: src/reuse/cli/lint.py:43
msgid "- Are there any deprecated licenses in the project?"
msgstr "- Czy są jakieś porzucone licencje w projekcie?"

#: src/reuse/cli/lint.py:47
msgid ""
"- Are there any license files in the LICENSES/ directory without file "
"extension?"
msgstr "- Czy są jakieś licencje w katalogu LICENSES/ bez rozszerzenia pliku?"

#: src/reuse/cli/lint.py:54
msgid ""
"- Are any licenses referred to inside of the project, but not included in "
"the LICENSES/ directory?"
msgstr ""
"- Czy są jakieś licencje przywołane w środku projektu, lecz nie uwzględnione "
"w katalogu LICENSES/?"

#: src/reuse/cli/lint.py:61
msgid ""
"- Are any licenses included in the LICENSES/ directory that are not used "
"inside of the project?"
msgstr ""
"- Czy są jakieś licencje uwzględnione w katalogu LICENSES/, które nie są w "
"środku projektu?"

#: src/reuse/cli/lint.py:66
msgid "- Are there any read errors?"
msgstr "- Czy są jakieś błędy odczytu?"

#: src/reuse/cli/lint.py:69
msgid "- Do all files have valid copyright and licensing information?"
msgstr ""
"- Czy wszystkie pliki mają ważną informację o prawach autorskich i "
"licencjonowaniu?"

#: src/reuse/cli/lint.py:81 src/reuse/cli/lint_file.py:38
msgid "Prevent output."
msgstr "Zapobiegaj wyjściu."

#: src/reuse/cli/lint.py:89 src/reuse/cli/supported_licenses.py:28
msgid "Format output as JSON."
msgstr "Formatuj wyjście jako JSON."

#: src/reuse/cli/lint.py:97
msgid "Format output as plain text. (default)"
msgstr "Formatuj wyjście jako zwykły tekst (domyślne)"

#: src/reuse/cli/lint.py:105
msgid "Format output as errors per line."
msgstr "Formatuj wyjście jako błędy w liniach."

#: src/reuse/cli/lint_file.py:25
msgid ""
"Lint individual files for REUSE compliance. The specified FILEs are checked "
"for the presence of copyright and licensing information, and whether the "
"found licenses are included in the LICENSES/ directory."
msgstr ""
"Sprawdzaj indywidualne pliki dla zgodności z REUSE. Określone PLIKI będą "
"sprawdzane pod kątem obecności informacji o prawach autorskich i "
"licencjonowaniu, i czy znalezione licencje są uwzględnione w katalogu "
"LICENSES/."

#: src/reuse/cli/lint_file.py:46
msgid "Format output as errors per line. (default)"
msgstr "Formatuj wyjście jako błędy w liniach. (domyślne)"

#. TRANSLATORS: You may translate this. Please preserve capital letters.
#: src/reuse/cli/lint_file.py:51
msgid "FILE"
msgstr "PLIK"

#: src/reuse/cli/lint_file.py:65
#, python-brace-format
msgid "'{file}' is not inside of '{root}'."
msgstr "„{file}” nie jest wewnątrz „{root}”."

#: src/reuse/cli/main.py:36
#: /root/.cache/pypoetry/virtualenvs/reuse-3tQ3zmSa-py3.13/lib/python3.13/site-packages/click/decorators.py:482
#, python-format
msgid "%(prog)s, version %(version)s"
msgstr "%(prog)s, wersja %(version)s"

#: src/reuse/cli/main.py:39
msgid ""
"This program is free software: you can redistribute it and/or modify it "
"under the terms of the GNU General Public License as published by the Free "
"Software Foundation, either version 3 of the License, or (at your option) "
"any later version."
msgstr ""
"Niniejszy program jest wolnym oprogramowaniem; możesz go rozprowadzać dalej "
"i/lub modyfikować na warunkach Powszechnej Licencji Publicznej GNU, wydanej "
"przez Fundację Wolnego Oprogramowania — według wersji 3 tej Licencji lub "
"(według twojego wyboru) którejś z późniejszych wersji."

#: src/reuse/cli/main.py:46
msgid ""
"This program is distributed in the hope that it will be useful, but WITHOUT "
"ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or "
"FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for "
"more details."
msgstr ""
"Niniejszy program rozpowszechniany jest z nadzieją, iż będzie on użyteczny – "
"jednak BEZ JAKIEJKOLWIEK GWARANCJI, nawet domyślnej gwarancji PRZYDATNOŚCI "
"HANDLOWEJ albo PRZYDATNOŚCI DO OKREŚLONYCH ZASTOSOWAŃ. W celu uzyskania "
"bliższych informacji sięgnij do Powszechnej Licencji Publicznej GNU."

#: src/reuse/cli/main.py:53
msgid ""
"You should have received a copy of the GNU General Public License along with "
"this program. If not, see <https://www.gnu.org/licenses/>."
msgstr ""
"Z pewnością wraz z niniejszym programem otrzymałeś też egzemplarz "
"Powszechnej Licencji Publicznej GNU (GNU General Public License); jeśli nie "
"– zobacz <http://www.gnu.org/licenses/>."

#: src/reuse/cli/main.py:61
msgid ""
"reuse is a tool for compliance with the REUSE recommendations. See <https://"
"reuse.software/> for more information, and <https://reuse.readthedocs.io/> "
"for the online documentation."
msgstr ""
"reuse jest narzędziem dla zgodności z rekomendacjami REUSE. Zobacz <https://"
"reuse.software/> dla więcej informacji oraz <https://reuse.readthedocs.io/> "
"dla dokumentacji online."

#: src/reuse/cli/main.py:68
msgid ""
"This version of reuse is compatible with version {} of the REUSE "
"Specification."
msgstr "Ta wersja reuse nie jest kompatybilna z wersją {} specyfikacji REUSE."

#: src/reuse/cli/main.py:72
msgid "Support the FSFE's work:"
msgstr "Wspieraj działalność FSFE:"

#: src/reuse/cli/main.py:77
msgid ""
"Donations are critical to our strength and autonomy. They enable us to "
"continue working for Free Software wherever necessary. Please consider "
"making a donation at <https://fsfe.org/donate/>."
msgstr ""
"Darowizny są krytyczne dla naszej siły i autonomii. Pozwalają nam "
"kontynuować działać dla Wolnego Oprogramowania gdy jest to konieczne. "
"Prosimy rozważyć złożenie darowizny na <https://fsfe.org/donate/>."

#: src/reuse/cli/main.py:88
msgid "Enable debug statements."
msgstr "Włącz ciągi debugowania."

#: src/reuse/cli/main.py:93
msgid "Hide deprecation warnings."
msgstr "Ukryj ostrzeżenia porzuconych funkcji."

#: src/reuse/cli/main.py:98
msgid "Do not skip over Git submodules."
msgstr "Nie pomijaj podmodułów Git'a."

#: src/reuse/cli/main.py:103
msgid "Do not skip over Meson subprojects."
msgstr "Nie pomijaj podprojektów Meson'a."

#: src/reuse/cli/main.py:108
msgid "Do not use multiprocessing."
msgstr "Nie przetwarzaj wielowątkowo."

#: src/reuse/cli/main.py:118
msgid "Define root of project."
msgstr "Określ główny katalog projektu."

#: src/reuse/cli/spdx.py:22
msgid "Generate an SPDX bill of materials."
msgstr "Generuj BOM produkcyjny SPDX."

#: src/reuse/cli/spdx.py:32
msgid "File to write to."
msgstr "Plik, do którego zapisać."

#: src/reuse/cli/spdx.py:38
msgid ""
"Populate the LicenseConcluded field; note that reuse cannot guarantee that "
"the field is accurate."
msgstr ""
"Wypełnij pole LicenseConcluded; proszę mieć na uwadze, że reuse nie może "
"zagwarantować dokładności pola."

#: src/reuse/cli/spdx.py:50
msgid "Name of the person signing off on the SPDX report."
msgstr "Nazwa osoby podpisującej się na raporcie SPDX."

#: src/reuse/cli/spdx.py:54
msgid "Name of the organization signing off on the SPDX report."
msgstr "Nazwa organizacji podpisującej się na raporcie SPDX."

#: src/reuse/cli/spdx.py:81
msgid ""
"'--creator-person' or '--creator-organization' is required when '--add-"
"license-concluded' is provided."
msgstr ""
"„--creator-person” lub „--creator-organization” jest wymagane, gdy ustawiono "
"„--add-license-concluded”."

